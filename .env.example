# Which backend to use:
#   cloud (default) - Lovable Cloud database, storage and scheduling
#   local           - self-contained SQLite + local files (Docker)
BACKEND=local

# Self-hosted settings (BACKEND=local)
DATA_DIR=/data
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
# Encrypts the PIN session cookie. Generated automatically on first start
# if not set here.
SESSION_SECRET=

# Cloud settings (BACKEND=cloud) are provided by the platform:
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY
